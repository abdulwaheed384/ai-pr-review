ction_rule","check_run","check_suite","create","delete","deployment","deployment_status","discussion","discussion_comment","fork","gollum","issues","issue_comment","label","merge_group","milestone","page_build","public","pull_request","pull_request_review","pull_request_review_comment","push","registry_package","release","repository","repository_dispatch","status","watch","workflow_dispatch","workflow_run"]},"minimized":null},{"url":"https://api.github.com/repos/abdulwaheed384/ai-pr-review/issues/comments/6129147235","html_url":"https://github.com/abdulwaheed384/ai-pr-review/pull/64#issuecomment-6129147235","issue_url":"https://api.github.com/repos/abdulwaheed384/ai-pr-review/issues/64","id":6129147235,"node_id":"IC_kwDOSN6Nm88AAAABbVNdYw","user":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"created_at":"2026-10-12T17:21:18Z","updated_at":"2026-10-12T17:21:18Z","body":"## AI Security Review\n**Experiment condition:** C\n**Automated operational score:** 85/100 — LOW — APPROVE\n*This tool is for demonstration purposes only.*\n\n### Summary\nThe AI reviewer reported 1 confirmed actionable finding(s).\n\n### Findings\n- **MEDIUM · POLICY_OR_COMPLIANCE · NSG diagnostic setting absent: NSG logs not forwarded to Log Analytics workspace**\n  - Category rationale: Policy LOG-001 requires that resources exposing Azure Monitor diagnostic categories have supported security-relevant logs enabled and forwarded to Log Analytics. The azurerm_network_security_group resource (nsg-demo-ai) supports the diagnostic categories NetworkSecurityGroupEvent and NetworkSecurityGroupRuleCounter. No azurerm_monitor_diagnostic_setting resource targeting this NSG is present anywhere in the supplied Terraform files. A Log Analytics workspace (law-prom06-tc01-uks) exists and is the stated destination for NSG logs per the README, but no diagnostic setting links the NSG to it.\n  - Evidence: azurerm_network_security_group.nsg (nsg-demo-ai) in terraform/nsg.tf — no azurerm_monitor_diagnostic_setting resource referencing this NSG's ID is present in any supplied file. azurerm_log_analytics_workspace.network (law-prom06-tc01-uks) exists in terraform/nsg.tf. README.md states: 'It tags all taggable resources with documented research values and configures supported NSG security logs in a 30-day Log Analytics workspace.'\n  - Analysis: The azurerm_network_security_group resource 'nsg-demo-ai' supports Azure Monitor diagnostic categories (NetworkSecurityGroupEvent, NetworkSecurityGroupRuleCounter), but no azurerm_monitor_diagnostic_setting is configured to forward those logs to the azurerm_log_analytics_workspace 'law-prom06-tc01-uks'. The README and inline comment in nsg.tf both state that TC01 requires diagnostic log collection and that NSG resource logs are the applicable diagnostic categories. The workspace, Private Link Scope, and private endpoint are all provisioned, but without the diagnostic setting the logs are never collected, making the entire logging infrastructure non-functional for its stated purpose.\n  - Impact: NSG flow and rule-counter logs are not collected. The logging infrastructure (workspace, AMPLS, private endpoint, DNS zones) is deployed but receives no NSG diagnostic data, defeating the LOG-001 collection requirement and the stated research design intent. Security events on the NSG boundary are unrecorded.\n  - Recommendation: Add an azurerm_monitor_diagnostic_setting resource that targets azurerm_network_security_group.nsg.id, specifies the log categories NetworkSecurityGroupEvent and NetworkSecurityGroupRuleCounter with enabled = true, and sets log_analytics_workspace_id = azurerm_log_analytics_workspace.network.id. Example:\n\nresource \"azurerm_monitor_diagnostic_setting\" \"nsg\" {\n  name                       = \"diag-nsg-demo-ai\"\n  target_resource_id         = azurerm_network_security_group.nsg.id\n  log_analytics_workspace_id = azurerm_log_analytics_workspace.network.id\n\n  enabled_log { category = \"NetworkSecurityGroupEvent\" }\n  enabled_log { category = \"NetworkSecurityGroupRuleCounter\" }\n}\n\n### Policy mappings\n- **LOG-001** — Diagnostic log collection and forwarding to Log Analytics (finding F-001)\n\n### Recommendation\nReview and remediate the confirmed findings above.\n","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/abdulwaheed384/ai-pr-review/issues/comments/6129147235/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":{"id":15368,"client_id":"Iv1.05c79e9ad1f6bdfa","slug":"github-actions","node_id":"MDM6QXBwMTUzNjg=","owner":{"login":"github","id":9919,"node_id":"MDEyOk9yZ2FuaXphdGlvbjk5MTk=","avatar_url":"https://avatars.githubusercontent.com/u/9919?v=4","gravatar_id":"","url":"https://api.github.com/users/github","html_url":"https://github.com/github","followers_url":"https://api.github.com/users/github/followers","following_url"