digraph G {
  graph [rankdir=TB, fontname="DejaVu Sans", bgcolor="#ffffff", nodesep=0.35, ranksep=0.32, pad=0.25, compound=true, newrank=true, ordering=out, splines=spline];
  node  [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#8a8984", penwidth=1.1, fontname="DejaVu Sans", fontsize=10, fontcolor="#1a1a19", margin="0.14,0.07"];
  edge  [color="#6b6a66", penwidth=1.1, arrowsize=0.7, fontname="DejaVu Sans", fontsize=8.5];

  // ---------- trigger
  trig [label=<<b>1  Test-case pull request</b><br/><font point-size="8.5" color="#52514e">fixture on its own branch · ground truth committed first<br/>repeat runs via workflow_dispatch</font>>, fillcolor="#f4f3f0"];

  subgraph cluster_job {
    label=<<b>GitHub Actions job: PROM06 Experimental Security Review</b><br/><font point-size="8.5" color="#52514e">mode INDEPENDENT (from PR #69, 13 Oct) · steps run in sequence · no tool receives another tool's output</font>>;
    labeljust="l"; fontsize=10.5; fontcolor="#1a1a19"; color="#2a78d6"; penwidth=1.3; style="rounded"; margin=14;

    cond [label=<<b>2  Record condition</b><br/><font point-size="8.5" color="#52514e">experiment-metadata.json</font>>];
    tf   [label=<<b>3  Terraform checks</b><br/><font point-size="8.5" color="#52514e">init · fmt -check · validate</font>>];

    subgraph cluster_scan {
      label=<<b>4  Rule-based scanners</b>>; labeljust="l"; fontsize=9.5; fontcolor="#52514e";
      style="rounded,filled"; fillcolor="#f7f7f5"; color="#c9c8c3"; margin=10;
      ck [label=<<b>tfsec 1.28.14</b><br/><font point-size="8.5" color="#52514e">default rule set</font>>];
      ts [label=<<b>Checkov 3.3.1</b><br/><font point-size="8.5" color="#52514e">--framework terraform</font>>];
    }

    subgraph cluster_ai {
      label=<<b>5  AI reviewer</b>>; labeljust="l"; fontsize=9.5; fontcolor="#1c5cab";
      style="rounded,filled"; fillcolor="#eef5fd"; color="#86b6ef"; margin=10;
      ctx [shape=note, style="filled", fillcolor="#ffffff", color="#86b6ef", label=<<font point-size="8.5"><b>Context sent</b><br/>changed .tf + all terraform/*.tf<br/>prompt.txt · policy.md · README.md</font>>];
      ai  [label=<<b>review_runner.py → Claude API</b><br/><font point-size="8.5" color="#1c5cab">claude-sonnet-4-6 · max 3 findings</font>>, fillcolor="#cfe3fb", color="#2a78d6"];
      val [label=<<b>Validate and classify</b><br/><font point-size="8.5" color="#52514e">JSON schema · CONFIRMED / NEEDS_CONTEXT /<br/>INFORMATIONAL / FALSE_POSITIVE<br/>only CONFIRMED shown and scored</font>>];
      ctx -> ai [style=dotted, arrowhead=none, color="#86b6ef"];
      ai -> val;
    }


    cc [shape=note, style="filled", fillcolor="#fdf1f1", color="#d03b3b", fontcolor="#a32626",
        label=<<font point-size="8.5"><b>Earlier Condition C only</b><br/>(9–12 Oct): scanner findings<br/>were added to the AI prompt;<br/>removed by PR #69</font>>];
    ck -> cc [style=dashed, color="#d03b3b", arrowhead=none];
    ts -> cc [style=dashed, color="#d03b3b", arrowhead=none];
    cc -> ai [style=dashed, color="#d03b3b"];

    out [label=<<b>6  Outputs</b><br/><font point-size="8.5" color="#52514e">three separate PR comments (Checkov · tfsec · AI)<br/>raw artefacts: JSON, logs, metadata</font>>];

    cond -> tf;
    tf -> ts; tf -> ck; tf -> ctx [lhead=cluster_ai];
    ck -> ts [style=invis, constraint=false];
    ck -> out; ts -> out; val -> out;
  }

  // ---------- evaluation
  gt [label=<<b>7  Researcher evaluation</b><br/><font point-size="8.5" color="#52514e">classified against ground truth · rubric scoring<br/>remediation re-tests → results workbook</font>>, fillcolor="#f4f3f0"];

  trig -> cond; out -> gt;
  {rank=same; ck; ts; ctx;}
  {rank=same; cc; ai;}

}
