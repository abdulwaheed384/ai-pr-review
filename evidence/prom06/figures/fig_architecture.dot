digraph G {
  graph [rankdir=TB, fontname="DejaVu Sans", bgcolor="#ffffff", nodesep=0.45, ranksep=0.42, pad=0.3, compound=true, newrank=true];
  node  [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#8a8984", penwidth=1.2, fontname="DejaVu Sans", fontsize=11, fontcolor="#1a1a19", margin="0.18,0.09"];
  edge  [color="#6b6a66", penwidth=1.2, arrowsize=0.75, fontname="DejaVu Sans", fontsize=9];

  pr [label=<<b>1. A test case is opened as a pull request</b><br/><font point-size="9" color="#52514e">its expected answer (ground truth) is written down first</font>>, fillcolor="#f4f3f0"];

  subgraph cluster_job {
    label=<<b>Automated pipeline (GitHub Actions)</b>>; labeljust="r"; fontsize=11; color="#2a78d6"; penwidth=1.3; style="rounded"; margin=16;

    tf [label=<<b>2. Check the Terraform code is valid</b>>];

    subgraph cluster_scan {
      label=""; 
      style="rounded,filled"; fillcolor="#f7f7f5"; color="#c9c8c3"; margin=12;
      ck [label=<<b>3a. Checkov</b><br/><font point-size="9" color="#52514e">rule-based scanner</font>>];
      ts [label=<<b>3b. tfsec</b><br/><font point-size="9" color="#52514e">rule-based scanner</font>>];
    }

    ai [label=<<b>3c. AI reviewer (Claude)</b><br/><font point-size="9" color="#1c5cab">reads the code and a short security policy</font>>, fillcolor="#cfe3fb", color="#2a78d6"];

    out [label=<<b>4. Each tool posts its own comment on the pull request</b>>];

    tf -> ck; tf -> ts; tf -> ai;
    ck -> out; ts -> out; ai -> out;
    ts -> ai [ltail=cluster_scan, style=dashed, color="#d03b3b", fontcolor="#a32626", constraint=false,
              label=<<font point-size="8.5">earlier runs only:<br/>scanner results were<br/>also given to the AI</font>>];
  }

  gt [label=<<b>5. Every result is checked against the ground truth</b>>, fillcolor="#f4f3f0"];

  pr -> tf; out -> gt;
  {rank=same; ck; ts; ai;}
}
